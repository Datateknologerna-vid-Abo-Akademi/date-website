#!/bin/sh
set -e

if ! command -v uv >/dev/null 2>&1; then
    echo "Warning: uv not available, skipping pre-push lint checks."
    exit 0
fi

# Same checks as the CI lint job (.github/workflows/web_startup.yaml), kept
# deliberately free of the test suite so pushes stay fast.
echo "Running ruff check..."
uv run ruff check .
echo "Running ruff format check..."
uv run ruff format --check .
echo "Running djlint..."
uv run djlint --check templates/
echo "Running mypy..."
uv run mypy .
